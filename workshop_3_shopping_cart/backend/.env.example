# ค่าตั้งค่าของระบบ (อ่านผ่าน dotenv) — ห้าม commit ไฟล์นี้

# --- MongoDB ---
DB_HOST=localhost
DB_PORT=27017
DB_NAME=inet_training_nodejs
# ถ้า MongoDB เปิดใช้ authentication ให้กรอก user/password (ถ้าไม่ใช้ ปล่อยว่าง)
DB_USER=
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- ผู้ดูแลระบบคนแรก (ใช้กับ npm run seed) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- อัปโหลดไฟล์ ---
# ขนาดไฟล์รูปสูงสุด (MB)
UPLOAD_MAX_MB=2
